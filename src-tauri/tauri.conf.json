{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkPT",
  "version": "2.8.0",
  "identifier": "com.markpt.editor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MarkPT - 代码文本编辑器",
        "width": 1024,
        "height": 768,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": true,
        "visible": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": false,
        "trafficLightPosition": { "x": 12, "y": 12 }
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "Copyright © 2024 MarkPT",
    "category": "DeveloperTool",
    "shortDescription": "MarkPT - 轻量化代码文本编辑器",
    "longDescription": "MarkPT 是一款对标 Notepad++ 的跨平台轻量化代码文本编辑器，基于 Tauri 2.x + Rust + React + Monaco Editor 构建，支持 100+ 语法高亮、正则查找替换、多标签编辑、宏录制、插件系统等功能。",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "signingIdentity": null,
      "entitlements": null
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "both",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "MarkPT"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
